import React, { useState, useEffect } from 'react';
import { QuestState, SquadId } from '../types';
import { Timer, CheckCircle2, XCircle, BrainCircuit, AlertTriangle, Swords, Gavel, Eye } from 'lucide-react';
import { SQUADS } from '../constants';

interface QuestModalProps {
  quest: QuestState | null;
  gems: number;
  activeSquadId: SquadId;
  onAnswer: (questionId: string, answerIndex: number, timeRemaining: number) => void;
  onCQCVerdict?: (winner: 'ATTACKER' | 'DEFENDER' | 'DRAW') => void;
  onUseGem: (cost: number) => void;
  isLoading?: boolean;
}

export const QuestModal: React.FC<QuestModalProps> = ({ quest, gems, activeSquadId, onAnswer, onCQCVerdict, isLoading }) => {
  const currentIndex = quest?.currentQuestionIndex ?? 0;
  const questions = quest?.questions ?? [];
  const currentQ = questions[currentIndex];

  const [selectedOption, setSelectedOption] = useState<number | null>(null);
  const [showResult, setShowResult] = useState(false);
  const [timeLeft, setTimeLeft] = useState(30);
  const [showCQCAnswer, setShowCQCAnswer] = useState(false);

  useEffect(() => {
    setTimeLeft(30); // Reset timer for new question
    setSelectedOption(null);
    setShowResult(false);
    setShowCQCAnswer(false);
  }, [currentIndex]); 

  useEffect(() => {
    if (showResult || isLoading || quest?.type === 'CQC') return;
    const timer = setInterval(() => {
      setTimeLeft((prev) => {
        if (prev <= 1) {
          handleTimeOut();
          return 0;
        }
        return prev - 1;
      });
    }, 1000);
    return () => clearInterval(timer);
  }, [showResult, isLoading, quest?.type]);

  const handleTimeOut = () => {
    if (!showResult && quest?.type !== 'CQC') {
      handleOptionClick(-1); 
    }
  };

  const handleOptionClick = (index: number) => {
    if (showResult || !currentQ) return;
    setSelectedOption(index);
    setShowResult(true);
    
    // Increased delay for result screen
    setTimeout(() => {
      onAnswer(currentQ.id, index, timeLeft);
    }, 3500);
  };

  if (isLoading) {
    return (
      <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/95 backdrop-blur-md">
        <div className="flex flex-col items-center animate-pulse">
            <BrainCircuit className="w-16 h-16 text-yellow-500 mb-4 animate-spin-slow" />
            <h2 className="text-2xl font-bold text-white tracking-widest font-serif">DECODING INTEL</h2>
            <p className="text-yellow-500 mt-2">Retrieving mission parameters...</p>
        </div>
      </div>
    );
  }

  if (!quest || !currentQ) return null;

  // -- CQC VIEW --
  if (quest.type === 'CQC' && quest.cqcStats && onCQCVerdict) {
      const attacker = SQUADS[activeSquadId];
      const defender = SQUADS[quest.cqcStats.defenderId];
      
      return (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/95 backdrop-blur-sm p-4">
             <div className="w-full max-w-4xl bg-slate-800 border-4 border-slate-600 rounded-lg shadow-2xl overflow-hidden relative flex flex-col max-h-[90vh]">
                 {/* CQC Header */}
                 <div className="bg-slate-950 p-4 border-b border-slate-700 flex justify-between items-center">
                     <div className="flex items-center gap-3">
                         <Gavel className="w-6 h-6 text-blue-400" />
                         <span className="font-bold text-white text-xl uppercase tracking-widest">Close Quarter Combat</span>
                     </div>
                     <div className="text-sm font-mono text-slate-400">ROUND {currentIndex + 1} / {questions.length}</div>
                 </div>

                 {/* Scoreboard */}
                 <div className="flex bg-slate-900 border-b border-slate-700">
                     <div className="flex-1 p-4 flex flex-col items-center border-r border-slate-700" style={{backgroundColor: `${attacker.color}10`}}>
                         <div className="text-xs font-bold uppercase tracking-widest mb-1 text-slate-400">Attacker</div>
                         <h3 className="text-xl font-black mb-2" style={{color: attacker.color}}>{attacker.name}</h3>
                         <div className="text-4xl font-mono text-white">{quest.cqcStats.attackerScore}</div>
                     </div>
                     <div className="flex-0 flex items-center justify-center px-4">
                         <Swords className="w-8 h-8 text-slate-600" />
                     </div>
                     <div className="flex-1 p-4 flex flex-col items-center" style={{backgroundColor: `${defender.color}10`}}>
                         <div className="text-xs font-bold uppercase tracking-widest mb-1 text-slate-400">Defender</div>
                         <h3 className="text-xl font-black mb-2" style={{color: defender.color}}>{defender.name}</h3>
                         <div className="text-4xl font-mono text-white">{quest.cqcStats.defenderScore}</div>
                     </div>
                 </div>

                 {/* Question Area */}
                 <div className="flex-1 p-10 flex flex-col items-center justify-center text-center overflow-y-auto">
                      <h3 className="text-2xl font-serif text-white mb-8">{currentQ.text}</h3>
                      
                      {!showCQCAnswer ? (
                          <button 
                             onClick={() => setShowCQCAnswer(true)}
                             className="flex items-center gap-2 px-6 py-3 bg-slate-700 hover:bg-slate-600 text-white rounded font-bold uppercase tracking-wider transition-colors"
                          >
                              <Eye className="w-4 h-4" /> Reveal Answer (Teacher Only)
                          </button>
                      ) : (
                          <div className="animate-in fade-in slide-in-from-bottom-2 w-full max-w-lg">
                              <div className="bg-black/30 p-4 rounded border border-white/10 mb-8">
                                  <div className="text-xs text-green-400 font-bold uppercase mb-1">Correct Answer</div>
                                  <div className="text-xl text-white font-medium">{currentQ.explanation}</div>
                              </div>
                              
                              <div className="grid grid-cols-3 gap-3">
                                  <button onClick={() => onCQCVerdict('ATTACKER')} className="p-4 bg-slate-800 border-2 border-slate-600 hover:border-white hover:bg-slate-700 rounded transition-all">
                                      <div className="text-xs text-slate-400 uppercase font-bold">Point to</div>
                                      <div className="font-bold text-white" style={{color: attacker.color}}>{attacker.name}</div>
                                  </button>
                                  <button onClick={() => onCQCVerdict('DRAW')} className="p-4 bg-slate-800 border-2 border-slate-600 hover:border-white hover:bg-slate-700 rounded transition-all">
                                      <div className="text-xs text-slate-400 uppercase font-bold">No Point</div>
                                      <div className="font-bold text-white">Next Round</div>
                                  </button>
                                  <button onClick={() => onCQCVerdict('DEFENDER')} className="p-4 bg-slate-800 border-2 border-slate-600 hover:border-white hover:bg-slate-700 rounded transition-all">
                                      <div className="text-xs text-slate-400 uppercase font-bold">Point to</div>
                                      <div className="font-bold text-white" style={{color: defender.color}}>{defender.name}</div>
                                  </button>
                              </div>
                          </div>
                      )}
                 </div>
             </div>
        </div>
      );
  }

  // -- STANDARD MCQ VIEW --
  const isCorrect = selectedOption === currentQ.correctAnswerIndex;
  const isLastQuestion = currentIndex >= questions.length - 1;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/95 backdrop-blur-sm p-4">
      <div className="w-full max-w-4xl bg-slate-800 border-2 border-slate-600 rounded-lg shadow-2xl overflow-hidden relative flex flex-col max-h-[90vh]">
        
        {/* FULL SCREEN RESULT OVERLAY */}
        {showResult && (
           <div className={`absolute inset-0 z-50 flex flex-col items-center justify-center p-6 text-center animate-in fade-in zoom-in-95 duration-300 ${isCorrect ? 'bg-green-600' : 'bg-red-600'}`}>
              <div className="animate-in slide-in-from-bottom-5 fade-in duration-500 flex flex-col items-center w-full max-w-lg">
                {isCorrect ? <CheckCircle2 className="w-24 h-24 text-white mb-4 drop-shadow-xl" /> : <XCircle className="w-24 h-24 text-white mb-4 drop-shadow-xl" />}
                
                <h2 className="text-4xl md:text-5xl font-black text-white mb-2 uppercase tracking-widest drop-shadow-md">
                   {isCorrect ? 'CORRECT!' : 'MISSION FAILED'}
                </h2>
                
                {isCorrect ? (
                    <div className="text-xl text-white/90 font-bold mb-8">
                        {isLastQuestion ? "SECTOR SECURED!" : "Proceeding to next target..."}
                    </div>
                ) : (
                    <div className="text-xl text-white/90 font-bold mb-8 uppercase">
                        Unit retreating. Turn ending.
                    </div>
                )}
                
                <div className="bg-black/20 p-6 rounded-xl border border-white/10 w-full backdrop-blur-sm shadow-xl text-left">
                    <div className="flex gap-2 text-white/70 font-bold text-xs uppercase mb-2">
                        Field Report
                    </div>
                    <p className="text-white text-lg font-medium leading-relaxed">
                       {currentQ.explanation}
                    </p>
                </div>
              </div>
           </div>
        )}

        {/* Normal Header */}
        <div className="bg-slate-950 p-6 flex justify-between items-center border-b border-slate-700">
          <div className="flex flex-col">
             <span className="text-xs font-bold uppercase tracking-widest text-slate-500 mb-1">Mission Progress</span>
             <div className="flex items-center gap-1">
                 {questions.map((_, i) => (
                     <div key={i} className={`w-8 h-2 rounded-sm ${i < currentIndex ? 'bg-green-500' : i === currentIndex ? 'bg-yellow-500 animate-pulse' : 'bg-slate-700'}`}></div>
                 ))}
             </div>
          </div>
          
          <div className={`flex items-center gap-2 text-2xl font-mono font-bold ${timeLeft < 10 ? 'text-red-500 animate-pulse' : 'text-white'}`}>
                <Timer className="w-6 h-6" />
                00:{timeLeft.toString().padStart(2, '0')}
          </div>
        </div>

        {/* Content */}
        <div className="p-8 md:p-12 overflow-y-auto flex-1 relative bg-[#0f172a]">
          
          <div className="mb-4 inline-flex items-center gap-2 px-3 py-1 rounded bg-red-900/30 border border-red-800 text-red-400 text-xs font-bold uppercase tracking-widest">
                <AlertTriangle className="w-3 h-3" /> Sudden Death Active
          </div>

          <h3 className="text-2xl md:text-3xl font-serif text-slate-100 mb-10 leading-relaxed drop-shadow-md">
            {currentQ.text}
          </h3>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {currentQ.options.map((option, idx) => {
              let btnClass = "p-6 rounded-lg border-2 text-left transition-all duration-200 flex items-center group relative overflow-hidden bg-slate-800 border-slate-700 hover:bg-slate-700 hover:border-yellow-500 text-slate-200 hover:text-white hover:shadow-lg hover:-translate-y-1";
              
              return (
                <button 
                  key={idx}
                  onClick={() => handleOptionClick(idx)}
                  disabled={showResult}
                  className={btnClass}
                >
                  <span className="w-8 h-8 rounded flex-shrink-0 flex items-center justify-center text-sm font-bold border bg-slate-900 border-slate-600 text-slate-400 group-hover:border-yellow-500 group-hover:text-yellow-500 mr-4">
                        {String.fromCharCode(65 + idx)}
                  </span>
                  <span className="text-lg font-medium">{option}</span>
                </button>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  );
};
