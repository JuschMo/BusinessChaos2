import React, { useMemo } from 'react';
import { Territory, SquadId } from '../types';
import { SQUADS } from '../constants';
import { Flag, Shield } from 'lucide-react';

interface HexMapProps {
  territories: Territory[];
  onTerritoryClick: (id: string) => void;
  selectedTerritoryId: string | null;
  activeSquadId: SquadId;
}

const HEX_SIZE = 50;

// Helper to convert axial coordinates (q, r) to pixel coordinates (x, y)
const hexToPixel = (q: number, r: number) => {
  const x = HEX_SIZE * (Math.sqrt(3) * q + (Math.sqrt(3) / 2) * r);
  const y = HEX_SIZE * ((3 / 2) * r);
  return { x, y };
};

const getRequiredCorrectAnswers = (difficulty: number) => {
    if (difficulty <= 2) return 3;
    if (difficulty <= 4) return 5;
    return 7;
};

const Hexagon: React.FC<{
  territory: Territory;
  isSelected: boolean;
  onClick: () => void;
}> = ({ territory, isSelected, onClick }) => {
  const { x, y } = hexToPixel(territory.q, territory.r);
  const squad = SQUADS[territory.owner];
  const requiredQs = getRequiredCorrectAnswers(territory.difficulty);
  
  // Calculate points for the polygon
  const points = useMemo(() => {
    const angles = [0, 60, 120, 180, 240, 300];
    return angles.map(angle => {
      const rad = (Math.PI / 180) * angle;
      return `${x + HEX_SIZE * Math.cos(rad)},${y + HEX_SIZE * Math.sin(rad)}`;
    }).join(' ');
  }, [x, y]);

  return (
    <g 
      className="transition-all duration-300 cursor-pointer hover:opacity-90"
      onClick={onClick}
    >
      {/* Main Hex Shape */}
      <polygon 
        points={points} 
        fill={squad.color}
        fillOpacity={territory.owner === SquadId.NEUTRAL ? 0.2 : 0.9}
        stroke={isSelected ? '#fff' : (territory.owner === SquadId.NEUTRAL ? '#555' : squad.secondaryColor)}
        strokeWidth={isSelected ? 4 : 2}
      />
      
      {/* Content inside Hex */}
      <foreignObject x={x - HEX_SIZE} y={y - HEX_SIZE} width={HEX_SIZE * 2} height={HEX_SIZE * 2} className="pointer-events-none">
        <div className="h-full w-full flex flex-col items-center justify-center text-center p-1">
          {territory.owner === SquadId.NEUTRAL ? (
             <div className="flex flex-col items-center">
               <div className="bg-slate-800/80 px-2 py-0.5 rounded text-[10px] font-bold text-white border border-slate-600 mb-1">
                   {requiredQs} Qs
               </div>
               <div className="flex gap-0.5">
                   {Array(territory.difficulty).fill(0).map((_, i) => (
                       <div key={i} className="w-1 h-2 bg-red-500 rounded-sm"></div>
                   ))}
               </div>
             </div>
          ) : (
             <Flag className="w-6 h-6 text-white mb-1 drop-shadow-md" />
          )}
          
          <span className="text-[9px] font-bold text-white leading-tight px-3 drop-shadow-md truncate w-full break-words whitespace-normal mt-1">
            {territory.name}
          </span>
        </div>
      </foreignObject>
    </g>
  );
};

export const HexMap: React.FC<HexMapProps> = ({ territories, onTerritoryClick, selectedTerritoryId, activeSquadId }) => {
  const centerX = 400; 
  const centerY = 300; 

  return (
    <div className="w-full h-full overflow-hidden flex items-center justify-center bg-[#1a1a1a] relative">
      <div className="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/aged-paper.png')] opacity-10 pointer-events-none"></div>
      
      <svg viewBox="0 0 800 600" className="w-full h-full max-w-4xl max-h-[80vh]">
        <g transform={`translate(${centerX}, ${centerY})`}>
          {territories.map(t => (
              <Hexagon 
                key={t.id} 
                territory={t} 
                isSelected={selectedTerritoryId === t.id}
                onClick={() => onTerritoryClick(t.id)}
              />
          ))}
        </g>
      </svg>
      
      <div className="absolute bottom-4 left-4 bg-slate-900/90 p-3 rounded-lg border border-slate-700 backdrop-blur-sm shadow-xl">
        <h4 className="text-[10px] text-slate-400 uppercase tracking-widest mb-2 border-b border-slate-700 pb-1">Territory Control</h4>
        <div className="flex gap-4">
            {Object.values(SQUADS).filter(s => s.id !== SquadId.NEUTRAL).map(s => (
                <div key={s.id} className="flex items-center gap-2">
                    <div className="w-3 h-3 rounded-sm transform rotate-45" style={{ backgroundColor: s.color }}></div>
                    <span className="text-xs font-bold text-slate-200">{s.name}</span>
                </div>
            ))}
             <div className="flex items-center gap-2">
                <div className="w-3 h-3 rounded-sm transform rotate-45 bg-slate-600 border border-slate-500"></div>
                <span className="text-xs font-bold text-slate-400">Neutral</span>
            </div>
        </div>
      </div>
    </div>
  );
};
