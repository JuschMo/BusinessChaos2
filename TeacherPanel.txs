import React, { useState } from 'react';
import { Territory, Question } from '../types';
import { Save, Trash2, Plus, ArrowLeft, GraduationCap } from 'lucide-react';

interface TeacherDashboardProps {
  territories: Territory[];
  customQuestions: Record<string, Question[]>;
  onAddQuestion: (territoryId: string, question: Question) => void;
  onDeleteQuestion: (territoryId: string, questionId: string) => void;
  onClose: () => void;
}

export const TeacherDashboard: React.FC<TeacherDashboardProps> = ({ 
  territories, 
  customQuestions, 
  onAddQuestion, 
  onDeleteQuestion,
  onClose 
}) => {
  const [selectedTerritoryId, setSelectedTerritoryId] = useState(territories[0].id);
  const [qText, setQText] = useState('');
  const [options, setOptions] = useState(['', '', '', '']);
  const [correctIdx, setCorrectIdx] = useState(0);
  const [explanation, setExplanation] = useState('');

  const handleSave = () => {
    if (!qText || options.some(o => !o) || !explanation) return;

    const newQ: Question = {
      id: `custom_${Date.now()}`,
      text: qText,
      options: [...options],
      correctAnswerIndex: correctIdx,
      explanation
    };

    onAddQuestion(selectedTerritoryId, newQ);
    
    // Reset form
    setQText('');
    setOptions(['', '', '', '']);
    setCorrectIdx(0);
    setExplanation('');
  };

  const handleOptionChange = (idx: number, val: string) => {
    const newOpts = [...options];
    newOpts[idx] = val;
    setOptions(newOpts);
  };

  const currentQuestions = customQuestions[selectedTerritoryId] || [];

  return (
    <div className="flex flex-col h-full bg-slate-900 text-slate-200">
      {/* Header */}
      <div className="p-4 bg-slate-950 border-b border-slate-800 flex justify-between items-center shadow-lg z-10">
        <h2 className="text-xl font-bold text-white flex items-center gap-2">
            <GraduationCap className="w-6 h-6 text-yellow-500" />
            <span className="text-yellow-500">COMMAND</span> CENTER <span className="text-slate-500 text-sm ml-2">(TEACHER MODE)</span>
        </h2>
        <button 
            onClick={onClose} 
            className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded border border-slate-700 flex items-center gap-2 font-bold transition-all"
        >
            <ArrowLeft className="w-4 h-4" /> Return to Map
        </button>
      </div>

      <div className="flex-1 flex overflow-hidden">
        {/* Sidebar - Territory List */}
        <div className="w-64 bg-slate-925 border-r border-slate-800 overflow-y-auto p-2 flex-shrink-0">
            <h3 className="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3 px-2 mt-2">Target Sector</h3>
            {territories.map(t => (
                <button
                    key={t.id}
                    onClick={() => setSelectedTerritoryId(t.id)}
                    className={`w-full text-left p-3 rounded mb-1 text-xs font-bold transition-all ${selectedTerritoryId === t.id ? 'bg-blue-900/40 text-blue-400 border border-blue-800' : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200 border border-transparent'}`}
                >
                    <div className="truncate">{t.name}</div>
                    <div className="text-[9px] text-slate-600 mt-1 truncate">{t.description}</div>
                </button>
            ))}
        </div>

        {/* Main Form Area */}
        <div className="flex-1 overflow-y-auto p-6 bg-[#0B1120]">
             <div className="max-w-4xl mx-auto space-y-8 pb-10">
                
                {/* Form */}
                <div className="bg-slate-800/80 backdrop-blur p-6 rounded-lg border border-slate-700 shadow-xl">
                    <h3 className="text-lg font-bold text-white mb-6 flex items-center gap-2 border-b border-slate-700 pb-2">
                        <Plus className="w-5 h-5 text-green-500" /> Encode New Intelligence
                    </h3>
                    
                    <div className="space-y-5">
                        <div>
                            <label className="block text-xs font-bold text-slate-400 uppercase mb-1">Question Text</label>
                            <textarea 
                                value={qText} 
                                onChange={e => setQText(e.target.value)}
                                className="w-full bg-slate-900 border border-slate-700 rounded p-3 text-sm focus:border-yellow-500 outline-none transition-colors text-white"
                                rows={2}
                                placeholder="Enter the historical question here..."
                            />
                        </div>

                        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                             {options.map((opt, i) => (
                                 <div key={i}>
                                     <label className="block text-xs font-bold text-slate-400 uppercase mb-1 flex justify-between items-center">
                                         <span>Option {String.fromCharCode(65+i)}</span>
                                         <div className="flex items-center gap-2 cursor-pointer" onClick={() => setCorrectIdx(i)}>
                                            <div className={`w-4 h-4 rounded-full border flex items-center justify-center ${correctIdx === i ? 'border-green-500 bg-green-500' : 'border-slate-600'}`}>
                                                {correctIdx === i && <div className="w-2 h-2 rounded-full bg-white" />}
                                            </div>
                                            <span className={`text-[10px] ${correctIdx === i ? 'text-green-400' : 'text-slate-600'}`}>Correct Answer</span>
                                         </div>
                                     </label>
                                     <input 
                                        type="text" 
                                        value={opt} 
                                        onChange={e => handleOptionChange(i, e.target.value)}
                                        className={`w-full bg-slate-900 border rounded p-2 text-sm outline-none transition-colors text-white ${correctIdx === i ? 'border-green-500/50 bg-green-900/10' : 'border-slate-700 focus:border-yellow-500'}`}
                                        placeholder={`Answer option ${i+1}`}
                                     />
                                 </div>
                             ))}
                        </div>

                        <div>
                            <label className="block text-xs font-bold text-slate-400 uppercase mb-1">Historical Context (Explanation)</label>
                            <textarea 
                                value={explanation} 
                                onChange={e => setExplanation(e.target.value)}
                                className="w-full bg-slate-900 border border-slate-700 rounded p-3 text-sm focus:border-yellow-500 outline-none transition-colors text-white"
                                rows={2}
                                placeholder="Explain why the answer is correct (shown after player answers)..."
                            />
                        </div>

                        <button 
                            onClick={handleSave}
                            disabled={!qText || options.some(o => !o) || !explanation}
                            className={`w-full py-3 rounded font-bold uppercase tracking-widest flex items-center justify-center gap-2 transition-all ${!qText || options.some(o => !o) || !explanation ? 'bg-slate-700 text-slate-500 cursor-not-allowed' : 'bg-green-600 hover:bg-green-500 text-white shadow-lg hover:shadow-green-900/30'}`}
                        >
                            <Save className="w-4 h-4" /> Save to Database
                        </button>
                    </div>
                </div>

                {/* Existing Questions */}
                <div>
                    <h3 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
                        Existing Intel <span className="bg-slate-800 text-slate-400 text-xs py-0.5 px-2 rounded-full">{currentQuestions.length}</span>
                    </h3>
                    <div className="space-y-3">
                        {currentQuestions.length === 0 && (
                            <div className="text-center p-8 bg-slate-800/30 rounded border border-dashed border-slate-700 text-slate-500">
                                No custom questions added for this sector yet.
                            </div>
                        )}
                        {currentQuestions.map((q, idx) => (
                            <div key={q.id} className="bg-slate-800 p-4 rounded border border-slate-700 flex justify-between items-start group hover:border-slate-600 transition-colors">
                                <div>
                                    <div className="font-bold text-slate-200 mb-1 flex items-start gap-2">
                                        <span className="text-slate-500 text-xs mt-0.5">#{idx+1}</span>
                                        {q.text}
                                    </div>
                                    <div className="text-xs text-green-400 bg-green-900/20 inline-block px-2 py-0.5 rounded border border-green-900/30 mt-1">
                                        Correct: {q.options[q.correctAnswerIndex]}
                                    </div>
                                    <div className="text-xs text-slate-500 mt-1 italic opacity-70">
                                        {q.explanation}
                                    </div>
                                </div>
                                <button 
                                    onClick={() => onDeleteQuestion(selectedTerritoryId, q.id)}
                                    className="p-2 text-slate-600 hover:text-red-400 hover:bg-red-900/20 rounded transition-all"
                                    title="Delete Question"
                                >
                                    <Trash2 className="w-4 h-4" />
                                </button>
                            </div>
                        ))}
                    </div>
                </div>

             </div>
        </div>
      </div>
    </div>
  );
};
