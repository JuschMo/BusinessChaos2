import React, { useState, useEffect, useRef } from 'react';
import { Squad, Player, ChatMessage } from '../types';
import { Users, Send, Trophy, Hash, Diamond } from 'lucide-react';
import { SQUADS, MOCK_USER } from '../constants';

interface SquadPanelProps {
  squad: Squad;
  chatHistory: ChatMessage[];
  gems: number;
  onSendMessage: (text: string) => void;
}

export const SquadPanel: React.FC<SquadPanelProps> = ({ squad, chatHistory, gems, onSendMessage }) => {
  const [msgInput, setMsgInput] = useState('');
  const chatEndRef = useRef<HTMLDivElement>(null);
  const [activeTab, setActiveTab] = useState<'CHAT' | 'MEMBERS'>('CHAT');

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [chatHistory, activeTab]);

  const handleSend = (e: React.FormEvent) => {
    e.preventDefault();
    if (!msgInput.trim()) return;
    onSendMessage(msgInput);
    setMsgInput('');
  };

  return (
    <div className="h-full flex flex-col bg-slate-900 border-l border-slate-800 w-full md:w-80 shadow-2xl z-20">
      {/* Header */}
      <div className="p-4 bg-slate-950 border-b border-slate-800">
        <h2 className="text-lg font-bold text-white flex items-center gap-2">
          <span className="w-3 h-3 rounded-full shadow-[0_0_10px_currentColor]" style={{ backgroundColor: squad.color }}></span>
          {squad.name}
        </h2>
        <div className="flex justify-between items-center mt-3 text-xs text-slate-400">
          <div className="flex items-center gap-1 bg-slate-900 px-2 py-1 rounded border border-slate-800">
            <Trophy className="w-3 h-3 text-yellow-600" />
            <span className="text-slate-300 font-bold">{squad.score} PTS</span>
          </div>
          <div className="flex items-center gap-1 bg-slate-900 px-2 py-1 rounded border border-slate-800">
             <Diamond className="w-3 h-3 text-purple-500 fill-current" />
             <span className="text-purple-400 font-bold">{gems} GEMS</span>
          </div>
        </div>
      </div>

      {/* Tabs */}
      <div className="flex border-b border-slate-800">
        <button 
            onClick={() => setActiveTab('CHAT')}
            className={`flex-1 py-3 text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2 transition-colors ${activeTab === 'CHAT' ? 'text-yellow-500 bg-slate-800 border-b-2 border-yellow-500' : 'text-slate-500 hover:text-slate-300'}`}
        >
            <Hash className="w-3 h-3" /> Secure Comms
        </button>
        <button 
            onClick={() => setActiveTab('MEMBERS')}
            className={`flex-1 py-3 text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2 transition-colors ${activeTab === 'MEMBERS' ? 'text-yellow-500 bg-slate-800 border-b-2 border-yellow-500' : 'text-slate-500 hover:text-slate-300'}`}
        >
            <Users className="w-3 h-3" /> Roster
        </button>
      </div>

      {/* Content */}
      <div className="flex-1 overflow-hidden relative bg-[#111]">
        {activeTab === 'CHAT' ? (
          <div className="h-full flex flex-col">
            <div className="flex-1 overflow-y-auto p-4 space-y-4">
              {chatHistory.map(msg => (
                <div key={msg.id} className={`flex flex-col ${msg.senderId === MOCK_USER.id ? 'items-end' : 'items-start'}`}>
                  {msg.isSystem ? (
                      <div className="w-full text-center my-2">
                          <span className="px-2 py-1 bg-yellow-900/20 border border-yellow-600/30 text-yellow-500 text-[10px] rounded uppercase font-bold tracking-widest">
                              {msg.text}
                          </span>
                      </div>
                  ) : (
                      <>
                        <span className="text-[10px] text-slate-500 mb-0.5">{msg.senderName}</span>
                        <div className={`px-3 py-2 rounded-lg max-w-[85%] text-xs md:text-sm shadow-md ${
                            msg.senderId === MOCK_USER.id 
                            ? 'bg-blue-700 text-white rounded-br-none' 
                            : 'bg-slate-700 text-slate-200 rounded-bl-none'
                        }`}>
                            {msg.text}
                        </div>
                      </>
                  )}
                </div>
              ))}
              <div ref={chatEndRef} />
            </div>
            
            <form onSubmit={handleSend} className="p-3 bg-slate-900 border-t border-slate-800 flex gap-2">
              <input 
                type="text" 
                value={msgInput}
                onChange={(e) => setMsgInput(e.target.value)}
                placeholder="Tactical coordination..."
                className="flex-1 bg-slate-950 border border-slate-700 rounded text-sm text-white px-3 py-2 focus:outline-none focus:border-yellow-600"
              />
              <button 
                type="submit"
                className="bg-yellow-700 hover:bg-yellow-600 text-white p-2 rounded transition-colors shadow-lg"
              >
                <Send className="w-4 h-4" />
              </button>
            </form>
          </div>
        ) : (
          <div className="h-full overflow-y-auto p-4">
             {/* Mock Members List */}
             <div className="space-y-3">
                <div className="flex items-center gap-3 bg-slate-800/50 p-3 rounded border border-slate-700/50">
                    <img src={MOCK_USER.avatar} className="w-10 h-10 rounded-full border-2 border-yellow-500" alt="Me" />
                    <div>
                        <div className="text-sm font-bold text-white">{MOCK_USER.name} (You)</div>
                        <div className="text-xs text-yellow-500 font-mono">Squad Leader</div>
                    </div>
                </div>
                {['Pvt. Ryan', 'Cpl. Miller', 'Sgt. Horvath'].map((name, i) => (
                    <div key={i} className="flex items-center gap-3 p-2 opacity-70 hover:opacity-100 transition-opacity border-b border-slate-800/50 pb-2">
                        <div className="w-8 h-8 rounded-full bg-slate-700 flex items-center justify-center text-xs font-bold text-slate-400">{name[0]}</div>
                         <div>
                            <div className="text-sm font-bold text-slate-300">{name}</div>
                            <div className="text-xs text-slate-500">Rifleman</div>
                        </div>
                    </div>
                ))}
             </div>
          </div>
        )}
      </div>
    </div>
  );
};
